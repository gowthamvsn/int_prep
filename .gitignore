# secrets — never commit
.env
*.env
!.env.example

# python
__pycache__/
*.pyc

# local venvs (recreated via requirements.txt on the host)
.venv-*/

# node (only used by local headless-diagram verification scripts)
node_modules/

# local runtime state — not needed for a fresh deploy, and would leak
# personal progress-tracking/QA history if committed
*.db
*.log
streamlit_progress.json

# Streamlit secrets (APP_PASSWORD etc.) — set these in Streamlit Cloud's
# "Secrets" panel instead, never commit a real secrets.toml
.streamlit/secrets.toml

# misc local scratch — not read by any server route, not needed to deploy
transcripts/
.claude/
model.joblib
nca_genl_qa_bank.json
WhatsApp Image*.jpeg
