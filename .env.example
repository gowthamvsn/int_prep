# Copy to .env for local dev. On Render (or any host), set these as the
# service's environment variables instead — never commit the real .env.

AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-06-01

# --- public-deployment only — leave BOTH unset for local dev (auth is skipped) ---
# The password you'll type on your phone to get into the Mastery Hub.
APP_PASSWORD=
# Random string that signs the login session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
